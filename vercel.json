{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth?action=$1" },
    { "source": "/api/cameras/(.*)", "destination": "/api/cameras?action=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cameras/cleanup", "schedule": "30 18 * * *" }
  ]
}
